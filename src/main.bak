#include <Globals.h>
#include <Pinsensor.h>
#include <PCF8575.h>
#include <ht16k33.h>
#include <Pindicator.h>

PCF8575 interface(PCF8575_ADDRESS);
PinSensor mySensor(&interface);
HT16K33 leds;
Pindicator myPindicator(&leds);

void setup(){        
    Serial.begin(115200);
    Wire.begin();
    mySensor.begin();;
    myPindicator.begin();
}

void loop(){
    myPindicator.showPinStatus(mySensor.getStatus().pins);
}